# Question 1
def is_even(n):
    if n % 2 == 0:
        return True
    else:
        return False

print(is_even(8))


# Question 2
def largest(a, b, c):
    if a >= b and a >= c:
        return a
    elif b >= a and b >= c:
        return b
    else:
        return c

print(largest(10, 25, 15))


# Question 3
def factorial(n):
    fact = 1
    for i in range(1, n + 1):
        fact = fact * i
    return fact

print(factorial(5))


# Question 4
def reverse_number(n):
    rev = 0
    while n > 0:
        digit = n % 10
        rev = rev * 10 + digit
        n = n // 10
    return rev

print(reverse_number(1234))


# Question 5
def sum_of_digits(n):
    total = 0
    while n > 0:
        digit = n % 10
        total = total + digit
        n = n // 10
    return total

print(sum_of_digits(1234))


# Question 6
def count_even_digits(n):
    count = 0
    while n > 0:
        digit = n % 10
        if digit % 2 == 0:
            count = count + 1
        n = n // 10
    return count

print(count_even_digits(123456))


# Question 7
def is_palindrome(n):
    temp = n
    rev = 0

    while n > 0:
        digit = n % 10
        rev = rev * 10 + digit
        n = n // 10

    if temp == rev:
        return True
    else:
        return False

print(is_palindrome(121))


# Question 8
def second_largest(lst):
    lst.sort()
    return lst[-2]

print(second_largest([10, 20, 30, 40, 50]))


# Question 9
def remove_duplicates(lst):
    new_list = []

    for i in lst:
        if i not in new_list:
            new_list.append(i)

    return new_list

print(remove_duplicates([1, 2, 2, 3, 4, 4, 5]))


# Question 10
def count_vowels(text):
    count = 0

    for i in text:
        if i in "aeiouAEIOU":
            count = count + 1

    return count

print(count_vowels("Python Programming"))


# Question 11
def common_elements(list1, list2):
    common = []

    for i in list1:
        if i in list2:
            common.append(i)

    return common

print(common_elements([1, 2, 3, 4], [3, 4, 5, 6]))


# Question 12
def prime_numbers(limit):
    primes = []

    for num in range(2, limit + 1):
        prime = True

        for i in range(2, num):
            if num % i == 0:
                prime = False
                break

        if prime:
            primes.append(num)

    return primes

print(prime_numbers(20))


